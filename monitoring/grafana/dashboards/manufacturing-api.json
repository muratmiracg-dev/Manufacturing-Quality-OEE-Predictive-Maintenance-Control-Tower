{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(manufacturing_recommendation_requests_total[5m]))",
          "legendFormat": "requests"
        }
      ],
      "title": "Recommendation request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(manufacturing_recommendation_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "title": "Recommendation latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(manufacturing_recommendation_requests_total{outcome=\"error\"}[5m])) / clamp_min(sum(rate(manufacturing_recommendation_requests_total[5m])), 0.001)",
          "legendFormat": "errors"
        }
      ],
      "title": "Error ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 8},
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(manufacturing_failure_probability_bucket[15m])) by (le)",
          "legendFormat": "<= {{le}}"
        }
      ],
      "title": "Failure-probability score distribution",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["manufacturing", "predictive-maintenance", "recommendation-only"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Manufacturing Recommendation API",
  "uid": "manufacturing-api",
  "version": 1
}

